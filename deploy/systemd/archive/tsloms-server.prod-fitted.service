# =============================================================================
# ⚠️ 已归档，禁止用于生产（P0-03）
#
# 本文件为旧“prod-fitted”基线，存在两个不一致风险：
#   - User=root（违反最小权限，应使用 tsloms 普通用户 + 强化沙箱）；
#   - EnvironmentFile=/opt/tsloms/packages/server/.env（旧路径，与制品化部署及
#     /etc/tsloms/tsloms.env 权威环境文件不一致），导致 CD restart 无法验证实际启用单元。
#
# 已由唯一权威单元 deploy/systemd/tsloms-server.service 取代。
# 仅作历史参考，不得部署到生产（systemctl cat 与 CD 校验都会以此为废弃项）。
# =============================================================================
[Unit]
Description=TSLOMS Server (ARCHIVED - DO NOT USE)
After=network.target mysql.service redis.service mosquitto.service

[Service]
Type=simple
# 生产为 root 运行（与当前一致，避免权限变化导致媒体/环境文件不可访问）
User=root
Group=root
# 制品化部署：working dir 与可执行文件均指向原子切换的 current 符号链接
WorkingDirectory=/opt/tsloms/current
ExecStart=/opt/tsloms/current/server
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=15

# 敏感配置继续从原 env 文件读取（与当前一致，不改路径避免密钥失效）
EnvironmentFile=/opt/tsloms/packages/server/.env

# 说明：MEDIA_DIR 由 .env 提供（已改为 /opt/tsloms/shared/media），
# 单元无需重复设置；systemd 中 Environment= 会被 EnvironmentFile 覆盖。

[Install]
WantedBy=multi-user.target
