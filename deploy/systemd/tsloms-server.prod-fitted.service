[Unit]
Description=TSLOMS Server
After=network.target mysql.service redis.service mosquitto.service

[Service]
Type=simple
# 生产为 root 运行（与当前一致，避免权限变化导致媒体/环境文件不可访问）
User=root
Group=root
# 制品化部署：working dir 与可执行文件均指向原子切换的 current 符号链接
WorkingDirectory=/opt/tsloms/current
ExecStart=/opt/tsloms/current/server
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=15

# 敏感配置继续从原 env 文件读取（与当前一致，不改路径避免密钥失效）
EnvironmentFile=/opt/tsloms/packages/server/.env

# 说明：MEDIA_DIR 由 .env 提供（已改为 /opt/tsloms/shared/media），
# 单元无需重复设置；systemd 中 Environment= 会被 EnvironmentFile 覆盖。

[Install]
WantedBy=multi-user.target
