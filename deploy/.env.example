# ===== TSLOMS 交通信号灯运维系统 环境变量配置 =====
# 文档版本：V2.0
# 更新日期：2026-08-13

# ===== 服务端配置 =====
SERVER_PORT=8093

# ===== 数据库配置 =====
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=tsloms

# ===== Redis 配置 =====
REDIS_ADDR=localhost:6379
REDIS_PASS=
REDIS_DB=1

# ===== JWT 配置 =====
JWT_SECRET=your_jwt_secret

# ===== MQTT 配置 =====
MQTT_BROKER=tcp://localhost:1883
MQTT_USERNAME=tsloms
MQTT_PASSWORD=
MQTT_CLIENT_ID=tsloms-server
MQTT_TOPIC_PREFIX=trafficLight

# ===== 部署配置 =====
DEPLOY_ENV=production
LOG_LEVEL=info
