# ===== TSLOMS 交通信号灯运维系统 环境变量配置 =====
# 文档版本：V2.2（安全基线 P0-03 整改）
# 更新日期：2026-08-15
#
# 该文件同时服务于：
#   - systemd：复制为 /etc/tsloms/tsloms.env 并 chmod 600（见 deploy/systemd/tsloms-server.service）
#   - docker-compose.prod.yml：作为 .env 提供基础设施凭据
# 切勿把真实密钥提交到仓库；本文件仅作模板。

# ===== 服务端 =====
SERVER_PORT=8093

# ===== 数据库（应用使用专用账号，非 root） =====
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=tsloms
# 应用账号密码（systemd 侧 DB_PASSWORD 与 compose 侧 DB_APP_PASSWORD 保持一致）
DB_PASSWORD=your_app_db_password
DB_APP_PASSWORD=your_app_db_password
DB_NAME=tsloms
# MySQL root 密码（仅 compose 初始化用；生产建议从 root 降权，应用不连 root）
DB_ROOT_PASSWORD=your_root_password

# ===== Redis（生产必须启用密码） =====
REDIS_ADDR=127.0.0.1:6379
REDIS_PASS=your_redis_password
REDIS_DB=1

# ===== JWT（生产至少 32 位强随机，禁止弱值） =====
JWT_SECRET=replace_with_at_least_32_char_random_secret

# ===== 首次初始化管理员密码（可选；为空则系统生成随机强密码并打印一次） =====
ADMIN_INIT_PASSWORD=

# ===== 超级管理员初始密码（可选；为空则系统生成随机强密码并打印一次，务必保存） =====
SUPER_ADMIN_PASSWORD=

# ===== MQTT / EMQX =====
MQTT_BROKER=tcp://127.0.0.1:1883
MQTT_USERNAME=tsloms
MQTT_PASSWORD=your_mqtt_password
MQTT_CLIENT_ID=tsloms-server
MQTT_TOPIC_PREFIX=trafficLight
# EMQX Dashboard 管理员密码（compose 用）
EMQX_DASHBOARD_PASSWORD=your_emqx_dashboard_password

# ===== 部署 =====
DEPLOY_ENV=production
LOG_LEVEL=info
